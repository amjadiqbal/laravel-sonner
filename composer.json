{
    "name": "amjadiqbal/laravel-sonner",
    "description": "Sonner toast notifications for Laravel without React: flash toasts from PHP with toast()->success(), show them with a Blade component, and toast from Livewire, Alpine or JavaScript with Sonner's real styles and animations.",
    "keywords": [
        "laravel",
        "laravel-package",
        "sonner",
        "toast",
        "toast-notifications",
        "toaster",
        "notifications",
        "flash-messages",
        "alerts",
        "blade",
        "livewire",
        "alpinejs",
        "ui"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://amjad.com.pk/laravel/packages/laravel-sonner",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-sonner/issues",
        "source": "https://github.com/amjadiqbal/laravel-sonner",
        "docs": "https://amjad.com.pk/laravel/packages/laravel-sonner"
    },
    "require": {
        "php": "^8.3",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "livewire/livewire": "^3.6|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "livewire/livewire": "Toasts from Livewire actions show without a page reload (^3.6 or ^4.0)."
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\Sonner\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\Sonner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\Sonner\\SonnerServiceProvider"
            ],
            "aliases": {
                "Sonner": "AmjadIqbal\\Sonner\\Facades\\Sonner"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
